# ==============================================================================
# SPICE ROUTE TRADING CO. - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express Backend Server Port
# ------------------------------------------------------------------------------
PORT=5000

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Key (LLM, RAG Chat & Invoice Intelligence)
# Where to get: https://aistudio.google.com/app/apikey (Free tier available)
# Powers: AI Chat Assistant, RAG queries, AI Invoice Extraction, & CrewAI Agent
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Deepgram Speech-To-Text (STT) API Key
# Where to get: https://console.deepgram.com/ ($200 free credit on signup)
# Powers: Real-time Voice Invoice Speech Recognition (Nova-3 Model)
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 4. Gmail SMTP Email Dispatch (Credit Recovery & Automated Monthly Statements)
# Where to get: Google Account -> Security -> 2-Step Verification -> App Passwords
# Note: Do NOT use your normal Gmail password; generate a 16-character App Password.
# ------------------------------------------------------------------------------
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
